# =============================================================
# Vending Machine Prototype — .env.example
#
# HƯỚNG DẪN SỬ DỤNG:
#   1. Sao chép file này thành .env (KHÔNG commit .env vào Git)
#   2. Điền giá trị thật vào .env trên máy local của bạn
#   3. Trên môi trường triển khai, dùng Secret Manager hoặc
#      biến môi trường của platform thay vì file .env
#
# LƯU Ý BẢO MẬT:
#   - Không bao giờ ghi giá trị thật vào file này
#   - Không commit .env vào Git
#   - Các giá trị bên dưới CHỈ là ví dụ mẫu
# =============================================================

# ─────────────────────────────────────────────
# Spring Boot Profile
# ─────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local

# ─────────────────────────────────────────────
# PostgreSQL Database
# ─────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/vending_machine_db
DATABASE_USERNAME=vending_user
DATABASE_PASSWORD=change_me_before_use

# ─────────────────────────────────────────────
# Payment Provider
# Điền sau khi chốt nhà cung cấp (SePay, PayOS, Casso, v.v.)
# ─────────────────────────────────────────────
PAYMENT_PROVIDER=sepay
PAYMENT_API_KEY=your_payment_api_key_here
PAYMENT_WEBHOOK_SECRET=your_webhook_secret_here
PAYMENT_BANK_ACCOUNT_NUMBER=your_bank_account_number_here
PAYMENT_BANK_ACCOUNT_NAME=YOUR_ACCOUNT_NAME

# ─────────────────────────────────────────────
# MQTT Broker
# Điền sau khi chọn broker (EMQX Cloud, HiveMQ Cloud, v.v.)
# ─────────────────────────────────────────────
MQTT_BROKER_URL=ssl://your-broker-host:8883
MQTT_CLIENT_ID=backend-vending-machine-001
MQTT_USERNAME=your_mqtt_backend_username
MQTT_PASSWORD=your_mqtt_backend_password
MQTT_CONNECTION_TIMEOUT_SEC=30
MQTT_KEEP_ALIVE_SEC=60

# ─────────────────────────────────────────────
# Machine Configuration
# ─────────────────────────────────────────────
MACHINE_ID=VM001

# ─────────────────────────────────────────────
# Admin Account (Initial Setup)
# ─────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change_this_strong_password_123

# ─────────────────────────────────────────────
# CORS — URL gốc của Frontend
# ─────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────
# Order Expiration
# ─────────────────────────────────────────────
ORDER_PAYMENT_EXPIRY_MINUTES=15
DISPENSE_COMMAND_EXPIRY_SECONDS=60

# ─────────────────────────────────────────────
# Admin Security & JWT (Bắt buộc tối thiểu 32 ký tự / 256 bits khi chạy thực tế)
# ─────────────────────────────────────────────
APP_ADMIN_JWT_SECRET=your_32_character_minimum_random_secret_here
APP_ADMIN_JWT_EXPIRATION_SECONDS=28800
APP_ADMIN_COOKIE_SECURE=false
APP_ADMIN_BOOTSTRAP_USERNAME=admin
APP_ADMIN_BOOTSTRAP_PASSWORD=your_secure_bootstrap_password_here

# ─────────────────────────────────────────────
# Frontend Environment Variables
# File: frontend/.env.local (không commit)
# Chỉ chứa giá trị KHÔNG nhạy cảm
# ─────────────────────────────────────────────
# VITE_API_BASE_URL=http://localhost:8080
# VITE_MACHINE_ID=VM001

# ─────────────────────────────────────────────
# Firmware (ESP32) — KHÔNG đưa vào code hay Git
# Lưu trong firmware/include/secrets.h (đã có trong .gitignore)
# ─────────────────────────────────────────────
# WIFI_SSID=your_wifi_name
# WIFI_PASSWORD=your_wifi_password
# MQTT_ESP32_USERNAME=your_esp32_mqtt_username
# MQTT_ESP32_PASSWORD=your_esp32_mqtt_password
# MQTT_BROKER_HOST=your-broker-host
# MQTT_BROKER_PORT=8883
