# Vending Machine Backend - Environment Variables Example
# Copy this file to .env (which is git-ignored) and replace placeholders with your local credentials.

# Server Port
PORT=8080

# Spring Active Profile (local, dev, test, prod)
SPRING_PROFILES_ACTIVE=local

# PostgreSQL Connection
DATABASE_URL=jdbc:postgresql://localhost:5432/vending_machine_dev
DATABASE_USERNAME=vending_user
DATABASE_PASSWORD=replace_with_your_db_password

# Machine Configuration
MACHINE_ID=VM001

# CORS Allowed Origin
FRONTEND_ORIGIN=http://localhost:5173

# Order Configuration
ORDER_EXPIRATION_MINUTES=15

# Payment Configuration (SePay / VietQR)
PAYMENT_DEMO_MODE=true
SEPAY_API_KEY=your_sepay_api_key_here
SEPAY_BANK_BIN=970422
SEPAY_BANK_NAME=MBBank
SEPAY_ACCOUNT_NUMBER=DEMO123456
SEPAY_ACCOUNT_NAME=DEMO SMART VENDING

# Dispense & Hardware Simulation Settings (Set DISPENSE_SIMULATOR_ENABLED=false in production)
DISPENSE_AUTO_TRIGGER=true
DISPENSE_COMMAND_TIMEOUT_SECONDS=45
DISPENSE_SIMULATOR_ENABLED=true
DISPENSE_SIMULATOR_ASYNC=false
DISPENSE_SIMULATOR_DEFAULT_SCENARIO=SUCCESS

# Admin Security & JWT (Bắt buộc tối thiểu 32 ký tự / 256 bits khi chạy thực tế)
APP_ADMIN_JWT_SECRET=your_32_character_minimum_random_secret_here
APP_ADMIN_JWT_EXPIRATION_SECONDS=28800
APP_ADMIN_COOKIE_SECURE=false
APP_ADMIN_BOOTSTRAP_USERNAME=admin
APP_ADMIN_BOOTSTRAP_PASSWORD=your_secure_bootstrap_password_here

