# ==============================================================================
# VENDING MACHINE PROTOTYPE — BACKEND ENVIRONMENT VARIABLES (RENDER + NEON)
# File: backend/.env.render.example
#
# HƯỚNG DẪN:
#   1. File này là danh sách biến môi trường chuẩn xác theo code Spring Boot thực tế.
#   2. Sao chép các cặp key=value này vào mục "Environment" trên Render Dashboard.
#   3. Tuyệt đối KHÔNG commit file chứa giá trị bí mật thật lên Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH SERVER & SPRING PROFILE
# ------------------------------------------------------------------------------
# Cổng lắng nghe (Render tự động cấp phát biến PORT, giữ mặc định 8080 trong Dockerfile)
PORT=8080

# Profile Spring Boot cho môi trường production:
# - Khuyến nghị đặt "prod" để tắt controller mô phỏng công khai (/api/v1/simulation/device)
# - Chỉ đặt "dev" nếu cần gọi API đổi scenario lỗi qua HTTP
SPRING_PROFILES_ACTIVE=prod

# Mã định danh máy bán hàng mặc định (khớp với seed data Flyway V2)
MACHINE_ID=VM001


# ------------------------------------------------------------------------------
# 2. CẤU HÌNH DATABASE POSTGRESQL (NEON.TECH)
# ------------------------------------------------------------------------------
# LƯU Ý QUAN TRỌNG VỀ ĐỊNH DẠNG URL:
# - Code Spring Boot sử dụng org.postgresql.Driver, BẮT BUỘC phải bắt đầu bằng "jdbc:postgresql://"
# - KHÔNG sử dụng định dạng "postgres://" hoặc "postgresql://" (sẽ gây lỗi No suitable driver found)
# - Lấy từ Neon Dashboard -> Connection Details -> Tab "JDBC"
DATABASE_URL=jdbc:postgresql://REPLACE_WITH_NEON_HOST:5432/neondb?sslmode=require

# Username kết nối Database trên Neon (BẮT BUỘC PHẢI KHAI BÁO, nếu không backend sẽ dùng mặc định "vending_user" và bị lỗi)
DATABASE_USERNAME=REPLACE_WITH_NEON_USERNAME

# Mật khẩu kết nối Database trên Neon
DATABASE_PASSWORD=REPLACE_WITH_NEON_PASSWORD


# ------------------------------------------------------------------------------
# 3. BẢO MẬT ADMIN & XÁC THỰC JWT (BẮT BUỘC)
# ------------------------------------------------------------------------------
# Khóa bí mật ký JWT: BẮT BUỘC tối thiểu 32 ký tự (256 bits).
# Nếu thiếu hoặc ngắn hơn 32 ký tự, AdminJwtService sẽ chặn khởi động backend!
APP_ADMIN_JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET_MIN_32_CHARS

# Thời hạn token admin (28800 giây = 8 tiếng)
APP_ADMIN_JWT_EXPIRATION_SECONDS=28800

# Bật cờ Secure cho cookie vì Render chạy trên HTTPS
APP_ADMIN_COOKIE_SECURE=true

# Tài khoản admin ban đầu (AdminBootstrapRunner sẽ tự động tạo nếu bảng admin_users rỗng)
APP_ADMIN_BOOTSTRAP_USERNAME=admin

# Mật khẩu admin ban đầu: BẮT BUỘC tối thiểu 8 ký tự
APP_ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD


# ------------------------------------------------------------------------------
# 4. CẤU HÌNH CORS (KẾT NỐI FRONTEND)
# ------------------------------------------------------------------------------
# URL của Frontend đã deploy trên Vercel/Cloudflare Pages
# QUAN TRỌNG: Phải có "https://", KHÔNG có dấu gạch chéo "/" ở cuối!
FRONTEND_ORIGIN=https://REPLACE_WITH_YOUR_VERCEL_FRONTEND_URL


# ------------------------------------------------------------------------------
# 5. CẤU HÌNH THANH TOÁN (DEMO MODE — VIETQR / SEPAY)
# ------------------------------------------------------------------------------
# Bật chế độ Demo: hiển thị VietQR với thông tin demo và chấp nhận webhook mô phỏng
# CẢNH BÁO: Đây là luồng MÔ PHỎNG, không giao dịch tiền thật qua tài khoản ngân hàng!
PAYMENT_DEMO_MODE=true

# API Key của SePay: để trống khi chạy DEMO MODE (backend tự động chấp nhận webhook mô phỏng)
SEPAY_API_KEY=

# Thông tin tài khoản ngân hàng hiển thị trên VietQR demo
SEPAY_BANK_BIN=970422
SEPAY_BANK_NAME=MBBank
SEPAY_ACCOUNT_NUMBER=DEMO123456
SEPAY_ACCOUNT_NAME=DEMO SMART VENDING


# ------------------------------------------------------------------------------
# 6. CẤU HÌNH XUẤT HÀNG MÔ PHỎNG (DISPENSE SIMULATOR)
# ------------------------------------------------------------------------------
# Tự động kích hoạt xuất hàng sau khi thanh toán được xác minh thành công
DISPENSE_AUTO_TRIGGER=true

# Thời gian chờ lệnh xuất hàng phản hồi (giây)
DISPENSE_COMMAND_TIMEOUT_SECONDS=45

# Thời gian quay động cơ lò xo mô phỏng (mili-giây)
DISPENSE_MOTOR_RUN_MS=800

# Bật bộ điều hợp mô phỏng ESP32 (SimulatedDeviceAdapter)
DISPENSE_SIMULATOR_ENABLED=true

# Chạy mô phỏng đồng bộ (false) để có kết quả ngay lập tức
DISPENSE_SIMULATOR_ASYNC=false

# Kịch bản mô phỏng mặc định: SUCCESS (thành công), FAILURE (lỗi), OFFLINE (mất kết nối)
DISPENSE_SIMULATOR_DEFAULT_SCENARIO=SUCCESS


# ------------------------------------------------------------------------------
# 7. CẤU HÌNH ĐƠN HÀNG (ORDER LIFECYCLE)
# ------------------------------------------------------------------------------
# Thời gian giữ chỗ và chờ thanh toán (phút) trước khi đơn hết hạn
ORDER_EXPIRATION_MINUTES=15
